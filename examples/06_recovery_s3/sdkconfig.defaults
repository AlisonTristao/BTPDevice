# ESP32-S3 DevKitC-1 N16R8: 16 MB flash, the table with the recovery.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../partitions/btpdev_16mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# The N16R8's 8 MB of octal PSRAM: the library's buffers go there by default
# (DeviceConfig::psram), and so do the Wi-Fi and lwIP buffers with the last line.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# PowerMode::Saving (`cfg -set power_save, on`): automatic light sleep and a
# slower CPU when idle. Profiling adds the time per mode to `btp -power`.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_PROFILING=y

menu "TraceKit"

    choice TRACEKIT_LOG_LEVEL_CHOICE
        prompt "Log level of the tracekit.* tags"
        default TRACEKIT_LOG_LEVEL_INFO
        help
            Applied by TraceKit::begin() to every tracekit.* tag with
            esp_log_level_set(). It cannot go above the project-wide
            CONFIG_LOG_MAXIMUM_LEVEL. Change a single tag at runtime with
            esp_log_level_set("tracekit.tcp", ESP_LOG_DEBUG).

        config TRACEKIT_LOG_LEVEL_NONE
            bool "No output"
        config TRACEKIT_LOG_LEVEL_ERROR
            bool "Error"
        config TRACEKIT_LOG_LEVEL_WARN
            bool "Warning"
        config TRACEKIT_LOG_LEVEL_INFO
            bool "Info"
        config TRACEKIT_LOG_LEVEL_DEBUG
            bool "Debug"
        config TRACEKIT_LOG_LEVEL_VERBOSE
            bool "Verbose"
    endchoice

    config TRACEKIT_LOG_LEVEL
        int
        default 0 if TRACEKIT_LOG_LEVEL_NONE
        default 1 if TRACEKIT_LOG_LEVEL_ERROR
        default 2 if TRACEKIT_LOG_LEVEL_WARN
        default 3 if TRACEKIT_LOG_LEVEL_INFO
        default 4 if TRACEKIT_LOG_LEVEL_DEBUG
        default 5 if TRACEKIT_LOG_LEVEL_VERBOSE

    menu "Links"
        help
            A link that is compiled out cannot be selected at runtime:
            begin() falls back to Serial (TRACEKIT_ERR_LINK_UNSUPPORTED).

        config TRACEKIT_LINK_SERIAL
            bool "Serial (native USB CDC or UART)"
            default y
            help
                DeviceConfig::serial_port picks the port: the native USB
                (TinyUSB CDC, ESP32-S2/S3/P4) or a UART, usually the one
                behind the board's USB-serial bridge.

        config TRACEKIT_LINK_TCP
            bool "TCP over Wi-Fi"
            default y

        config TRACEKIT_LINK_BLE
            bool "Bluetooth LE (needs NimBLE enabled in the Bluetooth menu)"
            depends on BT_NIMBLE_ENABLED
            default y

        config TRACEKIT_LINK_ESPNOW
            bool "ESP-NOW (through the bally_dongle)"
            default y

        config TRACEKIT_INSECURE_CLEARTEXT_RADIO
            bool "DEVELOPMENT ONLY: let TCP/BLE/ESP-NOW run without the device key"
            default n
            help
                Without a provisioned key, TCP, BLE and ESP-NOW refuse to start
                and the device falls back to Serial (anyone in radio range could
                read and command it otherwise). This lets them run in clear text
                for bench tests before a key is provisioned. Never ship it: the
                boot log warns every time.
    endmenu

endmenu
